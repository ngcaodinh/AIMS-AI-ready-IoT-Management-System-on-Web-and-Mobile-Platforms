# Mẫu cấu hình database local; backend/.env thật do bạn tự tạo và không đưa vào Git.
# Không đặt mật khẩu thật trong file mẫu. Điền mật khẩu local đã chọn ở hai vị trí placeholder.
# Endpoint DBeaver chỉ cấp inspection, không thay tài khoản writer của backend ứng dụng.
PGHOST=127.0.0.1
PGPORT=15432
PGDATABASE=iot_platform_lab
PGUSER=iot_dbeaver_reader
PGPASSWORD=REPLACE_WITH_LOCAL_PASSWORD
PGSSLMODE=disable
PGCONNECT_TIMEOUT=5
DATABASE_URL=postgresql://iot_dbeaver_reader:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:15432/iot_platform_lab?sslmode=disable
