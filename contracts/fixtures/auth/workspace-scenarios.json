          "description": "Phòng thử",
          "defaultTimezone": "Asia/Bangkok",
          "status": "ACTIVE",
          "revision": 1,
          "role": "ADMIN",
          "creatorId": "11111111-1111-4111-8111-111111111111",
          "membershipStatus": "ACTIVE",
          "authzVersion": 1,
          "membershipRevision": 1,
          "membershipAuthzVersion": 1,
          "createdAt": "2026-10-22T00:00:00Z",
          "archivedAt": null
        }
      },
      "assertions": ["workspace-membership-quota-preference-audit-atomic", "refetch-current-detail-before-select"]
    },
    {
      "id": "CT-WORKSPACE-SELECT-RECHECK",
      "operationId": "getWorkspaceDetail",
      "request": {
        "authState": "valid-full-current-active-admin-A",
        "path": {"id": "33333333-3333-4333-8333-333333333333"}
      },
      "response": {
        "status": 200,
        "headers": {"Cache-Control": "no-store"},
        "body": {
          "id": "33333333-3333-4333-8333-333333333333",
          "name": "Workspace A",
          "description": null,
          "defaultTimezone": "UTC",
          "status": "ACTIVE",
          "revision": 1,
          "role": "ADMIN",
          "creatorId": "11111111-1111-4111-8111-111111111111",
          "membershipStatus": "ACTIVE",
          "authzVersion": 1,
          "membershipRevision": 1,
          "membershipAuthzVersion": 1,
          "createdAt": "2026-10-22T00:00:00Z",
          "archivedAt": null
        }
      },
      "assertions": ["server-rechecks-membership", "no-workspace-resource-yet"]
    },
    {
      "id": "CT-WORKSPACE-SELECT-MEMBERSHIP-REMOVED",
      "operationId": "getWorkspaceDetail",
      "request": {
        "authState": "valid-full-membership-removed-after-list",
        "path": {"id": "33333333-3333-4333-8333-333333333333"}
      },
      "response": {
        "status": 404,
        "headers": {"Cache-Control": "no-store"},
        "body": {"error": {"code": "RESOURCE_NOT_FOUND", "message": "Không tìm thấy tài nguyên.", "details": {}, "correlationId": "corr_removed"}}
      },
      "assertions": ["no-stale-membership-grant", "no-resource-data"]
    },
    {
      "id": "CT-WORKSPACE-CREATE-QUOTA",
      "operationId": "createWorkspace",
      "request": {
        "authState": "valid-full-app-creator-has-five-workspaces",
        "headers": {"Content-Type": "application/json", "Idempotency-Key": "synthetic-intent-key-002"},
        "body": {"name": "Lab 6", "defaultTimezone": "UTC"}
      },
      "response": {
        "status": 409,
        "headers": {"Cache-Control": "no-store"},
        "body": {"error": {"code": "WORKSPACE_LIMIT_EXCEEDED", "message": "Đã đạt giới hạn workspace có thể tạo.", "details": {}, "correlationId": "corr_quota"}}
      },
      "assertions": ["no-sixth-workspace"]
    }
  ]
}
