<?xml version="1.0" encoding="utf-8"?>
<!-- Android12+/OEM có thể chuyển dữ liệu dù allowBackup=false; chặn cả hai đường cho preferences. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
